{
  "version": "1.0",
  "description": "Keyword dictionaries operationalising the 11 codebook categories (data/codebook.json) for classical, non-LLM text mining. Patterns are case-insensitive regular expressions matched at word starts. Terms were drafted from each category's codebook definition and include list, then pruned of words whose dominant meaning in SEC filings is legal or financial rather than values-related (listed under 'exclude_phrases', which are removed from the text before counting).",
  "exclude_phrases": [
    "with respect to", "in respect of", "respectively",
    "safe harbor", "safe-harbor",
    "shareholder engagement", "stockholder engagement", "investor engagement",
    "private equity", "equity award", "equity compensation", "equity grant", "equity plan", "equity incentive", "stockholders' equity", "shareholders' equity", "return on equity", "equity securities",
    "performance share", "performance stock", "performance unit", "performance period", "performance-based", "performance based", "performance goal", "performance metric", "performance award",
    "employee stock purchase", "employee benefit", "employees' retirement", "employee retirement income security act",
    "foundation for", "client account",
    "trust company", "voting trust"
  ],
  "categories": {
